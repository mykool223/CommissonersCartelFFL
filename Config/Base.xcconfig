// Settings shared by every configuration.
//
// Real values live in Config/Secrets.xcconfig, which is gitignored. Copy
// Secrets.example.xcconfig to Secrets.xcconfig and fill it in. Without that
// file the app still builds and runs — it just uses sample data.

PRODUCT_BUNDLE_IDENTIFIER = com.commissionerscartel.app
// Beta App Review runs per version string, not per build. The first build of
// a new MARKETING_VERSION waits for review before external testers can have
// it; later builds of the same version go straight out. So this moves only for
// a release worth announcing, and the build number — a timestamp, set by
// Scripts/archive.sh — carries everything else.
//
// 0.1.0 is what external testing was approved on, so builds of it reach the
// league immediately.
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// Placeholders. AppConfiguration treats REPLACE_ME as "not configured" and
// falls back to mock data, so a fresh clone runs with no setup.
ESPN_LEAGUE_ID = REPLACE_ME
SUPABASE_ANON_KEY = REPLACE_ME

// Host only — no scheme. A "//" in an xcconfig starts a comment, so the
// https:// prefix is added back in AppConfiguration.
SUPABASE_HOST = REPLACE_ME

// YES routes ESPN requests through the espn-proxy edge function, so the ESPN
// session cookies live in Supabase's secret store instead of on the device.
// Requires a deployed function; leave NO to talk to ESPN directly using
// credentials entered in Settings.
ESPN_VIA_PROXY = NO

// Set in Secrets.xcconfig. Empty is fine for simulator builds; signing a build
// for a device or TestFlight needs it.
DEVELOPMENT_TEAM =

// Empty means "work it out from today's date" (see AppConfiguration.currentSeason).
LEAGUE_SEASON =

// Optional: overrides anything above when the file exists.
#include? "Secrets.xcconfig"
