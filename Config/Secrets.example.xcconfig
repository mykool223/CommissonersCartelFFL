// Copy this file to Config/Secrets.xcconfig and fill in your league's values.
// Secrets.xcconfig is gitignored — never commit it.
//
//   cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig
//
// Note: none of these are high-value secrets. The league id is visible in your
// ESPN URL and the Supabase anon key is meant to be public — row level security
// is what protects the data. The genuinely sensitive values are your ESPN
// session cookies, which are never stored here; enter them in the app's
// Settings screen and they go to the Keychain.

// From your ESPN league URL: fantasy.espn.com/football/league?leagueId=1234567
ESPN_LEAGUE_ID = 1234567

// Supabase project host WITHOUT the https:// prefix ("//" starts an xcconfig comment).
// Find it in Supabase → Project Settings → API → Project URL.
SUPABASE_HOST = abcdefghijkl.supabase.co

// Supabase → Project Settings → API → Project API keys → anon / public
SUPABASE_ANON_KEY = eyJhbGciOi...

// YES routes ESPN through the espn-proxy edge function so the ESPN cookies stay
// server-side. Requires: supabase secrets set ESPN_S2=... ESPN_SWID='{...}'
// followed by supabase functions deploy espn-proxy
ESPN_VIA_PROXY = NO

// Your Apple Developer Team ID, needed to sign builds for a real device or
// TestFlight. Find it in Xcode > Settings > Accounts (select the team, the ID
// is shown), or at developer.apple.com > Membership.
// Leave blank to build for the simulator only.
DEVELOPMENT_TEAM =

// Leave blank to derive the season from today's date.
LEAGUE_SEASON =
