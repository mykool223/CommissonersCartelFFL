<?xml version="1.0" encoding="utf-8"?>
<!-- Coach Landry: fedora and tie, the way Tom Landry worked a sideline.
     Generated from the same paths as the iOS asset so the two cannot
     drift apart. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- fedora crown: taller than a cap, with the sides pinched in -->
    <path android:fillColor="#FF000000"
        android:pathData="M7.7,9.4 C7.7,4.6 9.1,2.4 12,2.4 C14.9,2.4 16.3,4.6 16.3,9.4 Z" />
    <!-- brim; the gap above it reads as the band -->
    <path android:fillColor="#FF000000"
        android:pathData="M3.0,11.4 a9.0,1.9 0 1 0 18.0,0 a9.0,1.9 0 1 0 -18.0,0 z" />
    <!-- collar, opened around the knot -->
    <path android:fillColor="#FF000000"
        android:pathData="M8.4,14.6 L10.2,14.2 L12,16.1 L13.8,14.2 L15.6,14.6 L15.6,16.4 L13.9,16.2 L12,17.6 L10.1,16.2 L8.4,16.4 Z" />
    <!-- tie knot, chunky enough to survive being drawn at 20pt -->
    <path android:fillColor="#FF000000"
        android:pathData="M10.3,15.8 L13.7,15.8 L14.1,18.2 L9.9,18.2 Z" />
    <!-- tie blade -->
    <path android:fillColor="#FF000000"
        android:pathData="M10.2,18.6 L13.8,18.6 L12.9,21.7 L12,22.7 L11.1,21.7 Z" />
</vector>
